// Static hosting on Cloudflare Workers: the Flutter web build, no Worker script.
// Build first: flutter build web --release --dart-define=API_URL=<api url> (base href "/").
{
  "name": "my",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./build/web",
    // Unknown paths serve index.html (the app routes with URL fragments anyway).
    "not_found_handling": "single-page-application"
  },
  // Preview links (development-<name>, pr-N-<name>) for preview.yml; Cloudflare Access protects them.
  "preview_urls": true
}
